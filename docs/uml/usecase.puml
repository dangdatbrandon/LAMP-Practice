@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor User
database "MySQL Database" as DB

rectangle "Colors Web App" {
  usecase "Log In" as UC2
  usecase "Search Colors" as UC3
  usecase "Add Color" as UC4
}

User --> UC2
User --> UC3
User --> UC4
UC3 --> DB
UC4 --> DB
@enduml
